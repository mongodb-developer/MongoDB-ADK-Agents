{
  "name": "MongoDB Atlas and Google Cloud ADK Agents",
  "dockerComposeFile": "docker-compose.yml",
  "service": "adk",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {}
  },
  "updateContentCommand": "bash .devcontainer/install-mongodb-db-tools.sh && bash .devcontainer/import.sh && bash .devcontainer/install-dependencies.sh",
  "postCreateCommand": "",
  "postAttachCommand": "",
  "postStartCommand": "",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "mongodb_groceries_agent/agent.py"
      ]
    },
    "vscode": {
      "extensions": [
        "mongodb.mongodb-vscode",
        "ms-python.python"
      ],
      "settings": {
        "workbench.editorAssociations": {
          "*.md": "vscode.markdown.preview.editor"
        }
      }
    }
  },
  "forwardPorts": [
    27017
  ],
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}"
}
